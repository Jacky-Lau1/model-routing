{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/model-routing/trusted-quality-command-catalog.schema.json",
  "title": "Hash-bound trusted quality command catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "catalog_id", "commands", "catalog_hash"],
  "properties": {
    "version": { "const": 1 },
    "catalog_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/TrustedQualityCommand" }
    },
    "catalog_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "TrustedQualityCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "executable", "argv", "cwd_mode", "timeout_ms", "max_output_bytes", "visibility"],
      "properties": {
        "command_id": { "enum": ["format_check", "lint", "typecheck", "unit_tests", "build", "project_acceptance"] },
        "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "argv": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000\\r\\n]*$" }
        },
        "cwd_mode": { "const": "worktree" },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 1800000 },
        "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "visibility": { "enum": ["visible", "hidden"] }
      },
      "allOf": [
        {
          "if": { "properties": { "visibility": { "const": "hidden" } }, "required": ["visibility"] },
          "then": { "properties": { "command_id": { "const": "project_acceptance" } } }
        }
      ]
    }
  }
}
