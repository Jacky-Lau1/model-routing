{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/model-routing/pilot-report.schema.json",
  "title": "S10 Pilot Run and Pair Reports",
  "oneOf": [{ "$ref": "#/$defs/PilotRunRecord" }, { "$ref": "#/$defs/PilotPairReport" }],
  "$defs": {
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "NullableCount": { "type": ["integer", "null"], "minimum": 0 },
    "NullableCost": { "type": ["number", "null"], "minimum": 0 },
    "TestSummary": { "type": "object", "additionalProperties": false, "required": ["passed", "failed", "not_run"], "properties": { "passed": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "not_run": { "type": "integer", "minimum": 0 } } },
    "WallClock": { "type": "object", "additionalProperties": false, "required": ["plan", "execute", "gate", "review", "repair", "total"], "properties": { "plan": { "$ref": "#/$defs/NullableCount" }, "execute": { "$ref": "#/$defs/NullableCount" }, "gate": { "$ref": "#/$defs/NullableCount" }, "review": { "$ref": "#/$defs/NullableCount" }, "repair": { "$ref": "#/$defs/NullableCount" }, "total": { "type": "integer", "minimum": 0 } } },
    "Costs": { "type": "object", "additionalProperties": false, "required": ["provider_reported_usd", "estimated_list_usd", "invoice_usd", "chatgpt_quota"], "properties": { "provider_reported_usd": { "$ref": "#/$defs/NullableCost" }, "estimated_list_usd": { "$ref": "#/$defs/NullableCost" }, "invoice_usd": { "$ref": "#/$defs/NullableCost" }, "chatgpt_quota": { "$ref": "#/$defs/NullableCost" } } },
    "PilotRunRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "task_id", "arm", "run_id", "base_fixture_hash", "task_package_hash", "route_binding_hash", "approval_hash", "execution_context_hash", "evidence_bundle_hash", "provider", "model", "endpoint_origin", "endpoint_path", "auth_alias", "first_pass_success", "final_acceptance", "visible_tests", "hidden_tests", "regression", "repair_count", "human_interventions", "automated_success", "violations", "ambiguity", "usage_by_stage_model", "provider_http_request_count", "wall_clock_ms", "costs", "pricing_catalog", "core_metrics_unavailable", "evidence_sufficient", "remaining_risks", "recommendation", "created_at", "record_hash"],
      "properties": {
        "version": { "const": 1 }, "task_id": { "$ref": "#/$defs/Id" }, "arm": { "enum": ["gpt_only", "hybrid"] }, "run_id": { "$ref": "#/$defs/Id" },
        "base_fixture_hash": { "$ref": "#/$defs/Hash" }, "task_package_hash": { "$ref": "#/$defs/Hash" }, "route_binding_hash": { "$ref": "#/$defs/Hash" }, "approval_hash": { "$ref": "#/$defs/Hash" }, "execution_context_hash": { "$ref": "#/$defs/Hash" }, "evidence_bundle_hash": { "$ref": "#/$defs/Hash" },
        "provider": { "type": "string" }, "model": { "type": ["string", "null"] }, "endpoint_origin": { "type": ["string", "null"] }, "endpoint_path": { "type": ["string", "null"] }, "auth_alias": { "type": ["string", "null"] },
        "first_pass_success": { "type": "boolean" }, "final_acceptance": { "type": "boolean" }, "visible_tests": { "$ref": "#/$defs/TestSummary" }, "hidden_tests": { "$ref": "#/$defs/TestSummary" }, "regression": { "type": "boolean" }, "repair_count": { "type": "integer", "minimum": 0 },
        "human_interventions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["type", "summary"], "properties": { "type": { "enum": ["manual_code_change", "scope_change", "provider_change", "model_change", "budget_change", "egress_change", "manual_resend", "gate_skip"] }, "summary": { "type": "string" } } } }, "automated_success": { "type": "boolean" },
        "violations": { "type": "object", "additionalProperties": false, "required": ["secret", "scope", "privacy", "routing", "main_workspace_pollution", "unexplained_duplicate_requests"], "properties": { "secret": { "type": "integer", "minimum": 0 }, "scope": { "type": "integer", "minimum": 0 }, "privacy": { "type": "integer", "minimum": 0 }, "routing": { "type": "integer", "minimum": 0 }, "main_workspace_pollution": { "type": "integer", "minimum": 0 }, "unexplained_duplicate_requests": { "type": "integer", "minimum": 0 } } },
        "ambiguity": { "type": "object", "additionalProperties": false, "required": ["attempts", "total_attempts", "attempt_rate", "requests", "total_requests", "request_rate"], "properties": { "attempts": { "type": "integer", "minimum": 0 }, "total_attempts": { "type": "integer", "minimum": 0 }, "attempt_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "requests": { "type": "integer", "minimum": 0 }, "total_requests": { "type": "integer", "minimum": 0 }, "request_rate": { "type": "number", "minimum": 0, "maximum": 1 } } },
        "usage_by_stage_model": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["stage", "provider", "model", "input_tokens", "output_tokens", "reasoning_tokens", "cache_hit_tokens", "cache_miss_tokens"], "properties": { "stage": { "enum": ["CLASSIFY", "PLAN", "TEXT_FRAME", "TEXT_EXPAND", "EXECUTE", "VALIDATE", "REVIEW", "VISUAL_REVIEW", "REPAIR", "SOL_DIAGNOSIS"] }, "provider": { "type": "string" }, "model": { "type": ["string", "null"] }, "input_tokens": { "$ref": "#/$defs/NullableCount" }, "output_tokens": { "$ref": "#/$defs/NullableCount" }, "reasoning_tokens": { "$ref": "#/$defs/NullableCount" }, "cache_hit_tokens": { "$ref": "#/$defs/NullableCount" }, "cache_miss_tokens": { "$ref": "#/$defs/NullableCount" } } } },
        "provider_http_request_count": { "$ref": "#/$defs/NullableCount" }, "wall_clock_ms": { "$ref": "#/$defs/WallClock" }, "costs": { "$ref": "#/$defs/Costs" },
        "pricing_catalog": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["version", "hash", "source_urls", "time_bands"], "properties": { "version": { "type": "string" }, "hash": { "$ref": "#/$defs/Hash" }, "source_urls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } }, "time_bands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["peak", "off_peak", "standard"] } } } }, { "type": "null" }] },
        "core_metrics_unavailable": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "evidence_sufficient": { "type": "boolean" }, "remaining_risks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "recommendation": { "enum": ["expand", "simplify", "stop"] }, "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }, "record_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "PilotPairReport": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "task_id", "gpt_only_run_hash", "hybrid_run_hash", "same_base_fixture", "same_scope", "same_hidden_gate", "same_wall_budget", "same_acceptance_criteria", "hybrid_acceptance_not_lower", "cost_reduction_percent", "hybrid_latency_increase_percent", "expansion_blockers", "recommendation", "created_at", "report_hash"],
      "properties": { "version": { "const": 1 }, "task_id": { "$ref": "#/$defs/Id" }, "gpt_only_run_hash": { "$ref": "#/$defs/Hash" }, "hybrid_run_hash": { "$ref": "#/$defs/Hash" }, "same_base_fixture": { "type": "boolean" }, "same_scope": { "type": "boolean" }, "same_hidden_gate": { "type": "boolean" }, "same_wall_budget": { "type": "boolean" }, "same_acceptance_criteria": { "type": "boolean" }, "hybrid_acceptance_not_lower": { "type": "boolean" }, "cost_reduction_percent": { "type": ["number", "null"] }, "hybrid_latency_increase_percent": { "type": ["number", "null"] }, "expansion_blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "recommendation": { "enum": ["expand", "simplify", "stop"] }, "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }, "report_hash": { "$ref": "#/$defs/Hash" } }
    }
  }
}
