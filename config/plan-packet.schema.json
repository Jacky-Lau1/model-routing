{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy Phase 0 Approved Router Plan Packet",
  "$comment": "S1 integrations must use TaskPackage + RouteBinding + ExecutionContext + ApprovalRecord. This schema remains for the unmigrated Phase 0 orchestrator only.",
  "type": "object",
  "required": ["version", "taskId", "objective", "nonGoals", "steps", "readFiles", "writeFiles", "dataClassification", "allowedFiles", "constraints", "acceptance", "validationCommands", "qualityPolicyHash", "route", "routeBinding"],
  "properties": {
    "version": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "objective": { "type": "string", "minLength": 1 },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "readFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "writeFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "dataClassification": { "enum": ["public", "private", "secret_restricted"] },
    "allowedFiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "validationCommands": { "type": "array", "uniqueItems": true, "items": { "enum": ["format_check", "lint", "typecheck", "unit_tests", "build", "project_acceptance"] } },
    "qualityPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "routeBinding": { "$ref": "./data-contracts.schema.json#/$defs/RouteBinding" },
    "route": {
      "type": "object",
      "required": ["stage", "provider", "model", "effort", "maxOutputTokens", "maxToolTurns", "timeoutMs", "maxRepairs", "mayEscalate", "reason", "requiresApproval"],
      "properties": {
        "stage": { "enum": ["TEXT_EXPAND", "EXECUTE"] },
        "provider": { "enum": ["openai-codex", "deepseek"] },
        "model": { "type": "string" },
        "effort": { "enum": ["none", "low", "medium", "high"] },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "maxToolTurns": { "type": "integer", "minimum": 0 },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "maxRepairs": { "type": "integer", "minimum": 0, "maximum": 1 },
        "mayEscalate": { "type": "boolean" },
        "reason": { "type": "string" },
        "requiresApproval": { "const": true },
        "promptCacheKey": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
