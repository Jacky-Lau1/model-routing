{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Router Plan Packet",
  "type": "object",
  "required": ["version", "taskId", "objective", "nonGoals", "steps", "allowedFiles", "constraints", "acceptance", "validationCommands", "route"],
  "properties": {
    "version": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "objective": { "type": "string", "minLength": 1 },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowedFiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "validationCommands": { "type": "array", "items": { "type": "string" } },
    "route": {
      "type": "object",
      "required": ["stage", "provider", "model", "effort", "maxOutputTokens", "maxToolTurns", "timeoutMs", "maxRepairs", "mayEscalate", "reason", "requiresApproval"],
      "properties": {
        "stage": { "enum": ["TEXT_EXPAND", "EXECUTE"] },
        "provider": { "enum": ["openai-codex", "deepseek"] },
        "model": { "type": "string" },
        "effort": { "enum": ["none", "low", "medium", "high"] },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "maxToolTurns": { "type": "integer", "minimum": 0 },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "maxRepairs": { "type": "integer", "minimum": 0, "maximum": 1 },
        "mayEscalate": { "type": "boolean" },
        "reason": { "type": "string" },
        "requiresApproval": { "const": true },
        "promptCacheKey": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
