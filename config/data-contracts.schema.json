{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/model-routing/data-contracts.schema.json",
  "title": "Model Routing S1 Data Contracts",
  "oneOf": [
    { "$ref": "#/$defs/TaskPackage" }, { "$ref": "#/$defs/RouteBinding" }, { "$ref": "#/$defs/ExecutionContext" },
    { "$ref": "#/$defs/ApprovalRecord" }, { "$ref": "#/$defs/AttemptRecord" }, { "$ref": "#/$defs/EvidenceBundle" },
    { "$ref": "#/$defs/UserPolicy" }, { "$ref": "#/$defs/ProjectPolicy" }, { "$ref": "#/$defs/EffectivePolicy" }
  ],
  "$defs": {
    "SafeIdentifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "GitObjectId": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "Timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "SafeText": { "type": "string", "not": { "pattern": "-----BEGIN (?:RSA |OPENSSH |EC |DSA )?PRIVATE KEY-----|\\b(?:api[_-]?key|secret|token|password)\\s*[:=]\\s*[^\\s,;]{6,}|\\bBearer\\s+[A-Za-z0-9._~-]{12,}|\\bAKIA[0-9A-Z]{16}\\b|\\bsk-(?:live-|test-)?[A-Za-z0-9_-]{16,}" } },
    "NonEmptySafeText": { "allOf": [{ "$ref": "#/$defs/SafeText" }, { "minLength": 1, "pattern": "\\S" }] },
    "SafeRelativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/|~|[A-Za-z]:)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F])(?!.*\\/$).+$" },
    "PathScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/SafeRelativePath" } },
    "RequestBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "max_provider_requests", "max_input_tokens", "max_output_tokens", "max_tool_calls", "max_request_wall_time_ms", "max_wall_time_ms", "max_estimated_cost_usd", "billing_mode"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 }, "max_provider_requests": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": "integer", "minimum": 1 }, "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 }, "max_request_wall_time_ms": { "type": "integer", "minimum": 1 }, "max_wall_time_ms": { "type": "integer", "minimum": 1 },
        "max_estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }, "billing_mode": { "enum": ["prepaid", "postpaid", "subscription", "unknown"] }
      }
    },
    "QualityGatePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "policy_id", "command_ids", "command_registry_hash", "max_diff_bytes", "max_file_bytes", "max_output_bytes", "max_wall_time_ms", "policy_hash"],
      "properties": {
        "version": { "const": 1 }, "policy_id": { "$ref": "#/$defs/SafeIdentifier" },
        "command_ids": { "type": "array", "uniqueItems": true, "items": { "enum": ["format_check", "lint", "typecheck", "unit_tests", "build", "project_acceptance"] } },
        "command_registry_hash": { "$ref": "#/$defs/Sha256" }, "max_diff_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "max_file_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }, "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "max_wall_time_ms": { "type": "integer", "minimum": 1, "maximum": 1800000 }, "policy_hash": { "$ref": "#/$defs/Sha256" }
      }
    },
    "EgressPolicy": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "deny" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "providers", "paths", "content_hashes", "authorization_id", "authorized_by", "authorized_at", "expires_at"],
          "properties": {
            "mode": { "const": "allow" }, "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["openai-codex", "deepseek", "local"] } },
            "paths": { "$ref": "#/$defs/PathScope" }, "content_hashes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Sha256" } },
            "authorization_id": { "$ref": "#/$defs/SafeIdentifier" }, "authorized_by": { "const": "user" }, "authorized_at": { "$ref": "#/$defs/Timestamp" },
            "expires_at": { "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
          }
        }
      ]
    },
    "ProjectEgressPolicy": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "deny" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "providers", "paths", "content_hashes"],
          "properties": { "mode": { "const": "allow" }, "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["openai-codex", "deepseek", "local"] } }, "paths": { "$ref": "#/$defs/PathScope" }, "content_hashes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Sha256" } } }
        }
      ]
    },
    "ContextManifestEntry": {
      "type": "object", "additionalProperties": false, "required": ["path", "kind", "selector", "content_hash", "source", "byte_length", "summary"],
      "properties": { "path": { "$ref": "#/$defs/SafeRelativePath" }, "kind": { "enum": ["file", "snippet", "symbol"] }, "selector": { "oneOf": [{ "$ref": "#/$defs/NonEmptySafeText" }, { "type": "null" }] }, "content_hash": { "$ref": "#/$defs/Sha256" }, "source": { "enum": ["workspace", "synthetic_fixture", "user_provided"] }, "byte_length": { "type": "integer", "minimum": 0 }, "summary": { "$ref": "#/$defs/SafeText" } }
    },
    "TaskPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "task_id", "goal", "background_summary", "acceptance_criteria", "non_goals", "forbidden_actions", "read_scope", "write_scope", "relevant_interfaces", "context_manifest", "validation_requirements", "stop_conditions", "data_classification", "egress_policy", "request_budget", "created_at", "task_package_hash"],
      "properties": {
        "version": { "const": 1 }, "task_id": { "$ref": "#/$defs/SafeIdentifier" }, "goal": { "$ref": "#/$defs/NonEmptySafeText" }, "background_summary": { "$ref": "#/$defs/SafeText" },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SafeText" } }, "non_goals": { "type": "array", "items": { "$ref": "#/$defs/SafeText" } }, "forbidden_actions": { "type": "array", "items": { "$ref": "#/$defs/SafeText" } },
        "read_scope": { "$ref": "#/$defs/PathScope" }, "write_scope": { "$ref": "#/$defs/PathScope" }, "relevant_interfaces": { "type": "array", "items": { "$ref": "#/$defs/SafeText" } }, "context_manifest": { "type": "array", "items": { "$ref": "#/$defs/ContextManifestEntry" } },
        "validation_requirements": { "type": "array", "items": { "$ref": "#/$defs/SafeText" } }, "stop_conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SafeText" } },
        "data_classification": { "enum": ["public", "private", "secret_restricted"] }, "egress_policy": { "$ref": "#/$defs/EgressPolicy" }, "request_budget": { "$ref": "#/$defs/RequestBudget" }, "created_at": { "$ref": "#/$defs/Timestamp" }, "task_package_hash": { "$ref": "#/$defs/Sha256" }
      }
    },
    "RouteBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "provider_id", "adapter_id", "model_id", "endpoint_origin", "endpoint_path", "wire_protocol", "auth_alias", "reasoning_mode", "reasoning_effort", "pricing_catalog_version", "pricing_catalog_hash", "request_budget", "read_scope", "write_scope", "network_scope", "environment_scope", "command_scope", "route_binding_hash"],
      "properties": {
        "version": { "const": 1 }, "provider_id": { "enum": ["openai-codex", "deepseek", "local"] }, "adapter_id": { "$ref": "#/$defs/SafeIdentifier" }, "model_id": { "$ref": "#/$defs/SafeIdentifier" },
        "endpoint_origin": { "type": "string", "pattern": "^(?:https://[A-Za-z0-9.-]+(?::[0-9]+)?|local://[A-Za-z0-9.-]+)$" }, "endpoint_path": { "type": "string", "pattern": "^/(?!/)(?!.*\\.\\.)(?!.*[?#]).+$" },
        "wire_protocol": { "enum": ["chat_completions", "responses", "local"] }, "auth_alias": { "oneOf": [{ "$ref": "#/$defs/SafeIdentifier" }, { "type": "null" }] }, "reasoning_mode": { "enum": ["disabled", "enabled", "local"] }, "reasoning_effort": { "enum": ["none", "low", "medium", "high"] }, "pricing_catalog_version": { "type": ["string", "null"] }, "pricing_catalog_hash": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "request_budget": { "$ref": "#/$defs/RequestBudget" }, "read_scope": { "$ref": "#/$defs/PathScope" }, "write_scope": { "$ref": "#/$defs/PathScope" },
        "network_scope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?$" } }, "environment_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/SafeIdentifier" } }, "command_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/SafeIdentifier" } }, "route_binding_hash": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ExecutionContext": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "run_id", "task_id", "base_commit", "main_workspace_snapshot", "main_workspace_dirty_evidence", "worktree_id", "worktree_base", "policy_hash", "task_package_hash", "route_binding_hash", "created_at", "execution_context_hash"],
      "properties": {
        "version": { "const": 1 }, "run_id": { "$ref": "#/$defs/SafeIdentifier" }, "task_id": { "$ref": "#/$defs/SafeIdentifier" }, "base_commit": { "$ref": "#/$defs/GitObjectId" }, "main_workspace_snapshot": { "$ref": "#/$defs/Sha256" },
        "main_workspace_dirty_evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "status", "content_hash"], "properties": { "path": { "$ref": "#/$defs/SafeRelativePath" }, "status": { "enum": ["modified", "added", "deleted", "renamed", "untracked"] }, "content_hash": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] } } } },
        "worktree_id": { "$ref": "#/$defs/SafeIdentifier" }, "worktree_base": { "$ref": "#/$defs/GitObjectId" }, "policy_hash": { "$ref": "#/$defs/Sha256" }, "task_package_hash": { "$ref": "#/$defs/Sha256" }, "route_binding_hash": { "$ref": "#/$defs/Sha256" }, "created_at": { "$ref": "#/$defs/Timestamp" }, "execution_context_hash": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ApprovalRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "approval_id", "task_id", "task_package_hash", "route_binding_hash", "execution_context_hash", "policy_hash", "approved_scope_summary", "approved_at", "expires_at", "approval_hash"],
      "properties": { "version": { "const": 1 }, "approval_id": { "$ref": "#/$defs/SafeIdentifier" }, "task_id": { "$ref": "#/$defs/SafeIdentifier" }, "task_package_hash": { "$ref": "#/$defs/Sha256" }, "route_binding_hash": { "$ref": "#/$defs/Sha256" }, "execution_context_hash": { "$ref": "#/$defs/Sha256" }, "policy_hash": { "$ref": "#/$defs/Sha256" }, "approved_scope_summary": { "$ref": "#/$defs/NonEmptySafeText" }, "approved_at": { "$ref": "#/$defs/Timestamp" }, "expires_at": { "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }, "approval_hash": { "$ref": "#/$defs/Sha256" } }
    },
    "AttemptRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "attempt_id", "run_id", "stage", "round", "request_fingerprint", "status", "prepared_at", "send_started_at", "completed_at", "failure_class", "provider_request_id", "response_model", "response_origin", "usage", "transport_rounds", "provider_reported_cost_usd", "estimated_list_cost_usd", "redacted_error"],
      "properties": {
        "version": { "const": 1 }, "attempt_id": { "$ref": "#/$defs/SafeIdentifier" }, "run_id": { "$ref": "#/$defs/SafeIdentifier" }, "stage": { "enum": ["CLASSIFY", "PLAN", "TEXT_FRAME", "TEXT_EXPAND", "EXECUTE", "VALIDATE", "REVIEW", "VISUAL_REVIEW", "REPAIR", "SOL_DIAGNOSIS"] }, "round": { "type": "integer", "minimum": 0 }, "request_fingerprint": { "$ref": "#/$defs/Sha256" }, "status": { "enum": ["PREPARED", "SENDING", "SUCCEEDED", "FAILED_BEFORE_SEND", "AMBIGUOUS", "CANCELLED"] },
        "prepared_at": { "$ref": "#/$defs/Timestamp" }, "send_started_at": { "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }, "completed_at": { "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }, "failure_class": { "enum": ["none", "local_preflight", "provider_rejected", "transport_unknown", "response_invalid", "cancelled"] },
        "provider_request_id": { "type": ["string", "null"] }, "response_model": { "type": ["string", "null"] }, "response_origin": { "type": ["string", "null"] },
        "usage": { "oneOf": [{ "$ref": "#/$defs/AttemptUsage" }, { "type": "null" }] }, "transport_rounds": { "type": "array", "items": { "$ref": "#/$defs/ProviderTransportRound" } }, "provider_reported_cost_usd": { "type": ["number", "null"], "minimum": 0 }, "estimated_list_cost_usd": { "type": ["number", "null"], "minimum": 0 }, "redacted_error": { "oneOf": [{ "$ref": "#/$defs/SafeText" }, { "type": "null" }] }
      }
    },
    "AttemptUsage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "reasoning_tokens", "cached_input_tokens", "cache_write_tokens", "cache_hit_tokens", "cache_miss_tokens"],
      "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 }, "reasoning_tokens": { "type": "integer", "minimum": 0 }, "cached_input_tokens": { "type": "integer", "minimum": 0 }, "cache_write_tokens": { "type": "integer", "minimum": 0 }, "cache_hit_tokens": { "type": "integer", "minimum": 0 }, "cache_miss_tokens": { "type": "integer", "minimum": 0 } }
    },
    "ProviderTransportRound": {
      "type": "object", "additionalProperties": false,
      "required": ["round_id", "sequence", "stage", "request_id", "started_at", "completed_at", "wall_clock_time_ms", "response_model", "response_origin", "response_path", "http_status", "outcome", "failure_class", "usage", "cache_status", "provider_reported_cost_usd", "estimated_list_cost_usd", "pricing_catalog_version", "pricing_catalog_hash", "pricing_time_band"],
      "properties": { "round_id": { "$ref": "#/$defs/SafeIdentifier" }, "sequence": { "type": "integer", "minimum": 0 }, "stage": { "enum": ["CLASSIFY", "PLAN", "TEXT_FRAME", "TEXT_EXPAND", "EXECUTE", "VALIDATE", "REVIEW", "VISUAL_REVIEW", "REPAIR", "SOL_DIAGNOSIS"] }, "request_id": { "type": ["string", "null"] }, "started_at": { "$ref": "#/$defs/Timestamp" }, "completed_at": { "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }, "wall_clock_time_ms": { "type": ["integer", "null"], "minimum": 0 }, "response_model": { "type": ["string", "null"] }, "response_origin": { "type": ["string", "null"] }, "response_path": { "type": ["string", "null"] }, "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 }, "outcome": { "enum": ["SUCCEEDED", "REJECTED", "AMBIGUOUS"] }, "failure_class": { "type": ["string", "null"] }, "usage": { "oneOf": [{ "$ref": "#/$defs/AttemptUsage" }, { "type": "null" }] }, "cache_status": { "enum": ["hit", "miss", "mixed", "none", "unknown"] }, "provider_reported_cost_usd": { "type": ["number", "null"], "minimum": 0 }, "estimated_list_cost_usd": { "type": ["number", "null"], "minimum": 0 }, "pricing_catalog_version": { "type": ["string", "null"] }, "pricing_catalog_hash": { "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] }, "pricing_time_band": { "enum": ["peak", "off_peak", "standard", null] } }
    },
    "EvidenceBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "bundle_id", "run_id", "task_id", "contract_provenance", "task_package_hash", "route_binding_hash", "policy_hash", "quality_policy_hash", "quality_policy", "approval_hash", "execution_context_hash", "isolation_hash", "worktree_id", "base_commit", "worktree_head", "quality_request_hash", "quality_report_hash", "quality_passed", "quality_write_scope", "quality_command_ids", "post_artifact_snapshot_hash", "worktree_snapshot_hash", "attempt_ids", "route_evidence_ids", "attempt_summaries", "route_evidence_summaries", "transport_rounds", "files_changed", "content_snapshot_hash", "diff_hash", "diff_reference", "quality_gate_results", "tests_run", "scope_violations", "privacy_violations", "secret_scan_summary", "usage_metrics", "cost_metrics", "pricing_catalog", "wall_clock_time_ms", "stage_wall_clock_ms", "repair_count", "remaining_risks", "redaction_notes", "bundle_hash"],
      "properties": {
        "version": { "const": 3 }, "bundle_id": { "$ref": "#/$defs/SafeIdentifier" }, "run_id": { "$ref": "#/$defs/SafeIdentifier" }, "task_id": { "$ref": "#/$defs/SafeIdentifier" }, "contract_provenance": { "enum": ["canonical", "legacy_bridge"] }, "task_package_hash": { "$ref": "#/$defs/Sha256" }, "route_binding_hash": { "$ref": "#/$defs/Sha256" }, "policy_hash": { "$ref": "#/$defs/Sha256" }, "quality_policy_hash": { "$ref": "#/$defs/Sha256" }, "quality_policy": { "$ref": "#/$defs/QualityGatePolicy" }, "approval_hash": { "$ref": "#/$defs/Sha256" }, "execution_context_hash": { "$ref": "#/$defs/Sha256" }, "isolation_hash": { "$ref": "#/$defs/Sha256" }, "worktree_id": { "$ref": "#/$defs/SafeIdentifier" }, "base_commit": { "$ref": "#/$defs/GitObjectId" }, "worktree_head": { "$ref": "#/$defs/GitObjectId" }, "quality_request_hash": { "$ref": "#/$defs/Sha256" }, "quality_report_hash": { "$ref": "#/$defs/Sha256" }, "quality_passed": { "type": "boolean" }, "quality_write_scope": { "$ref": "#/$defs/PathScope" }, "quality_command_ids": { "type": "array", "uniqueItems": true, "items": { "enum": ["format_check", "lint", "typecheck", "unit_tests", "build", "project_acceptance"] } }, "post_artifact_snapshot_hash": { "$ref": "#/$defs/Sha256" }, "worktree_snapshot_hash": { "$ref": "#/$defs/Sha256" },
        "attempt_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/SafeIdentifier" } }, "route_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/SafeIdentifier" } },
        "attempt_summaries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["attempt_id", "stage", "status", "failure_class"], "properties": { "attempt_id": { "$ref": "#/$defs/SafeIdentifier" }, "stage": { "enum": ["CLASSIFY", "PLAN", "TEXT_FRAME", "TEXT_EXPAND", "EXECUTE", "VALIDATE", "REVIEW", "VISUAL_REVIEW", "REPAIR", "SOL_DIAGNOSIS"] }, "status": { "enum": ["PREPARED", "SENDING", "SUCCEEDED", "FAILED_BEFORE_SEND", "AMBIGUOUS", "CANCELLED"] }, "failure_class": { "enum": ["none", "local_preflight", "provider_rejected", "transport_unknown", "response_invalid", "cancelled"] } } } },
        "route_evidence_summaries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "provider", "model", "verification_status", "request_id_present"], "properties": { "evidence_id": { "$ref": "#/$defs/SafeIdentifier" }, "provider": { "$ref": "#/$defs/SafeText" }, "model": { "$ref": "#/$defs/SafeText" }, "verification_status": { "enum": ["route_tuple_verified_peer_unobserved", "incomplete", "local"] }, "request_id_present": { "type": "boolean" } } } },
        "transport_rounds": { "type": "array", "items": { "$ref": "#/$defs/ProviderTransportRound" } },
        "files_changed": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/SafeRelativePath" } }, "content_snapshot_hash": { "$ref": "#/$defs/Sha256" }, "diff_hash": { "$ref": "#/$defs/Sha256" }, "diff_reference": { "$ref": "#/$defs/SafeRelativePath" },
        "quality_gate_results": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["gate_id", "outcome", "evidence_hash", "summary"], "properties": { "gate_id": { "$ref": "#/$defs/SafeIdentifier" }, "outcome": { "enum": ["passed", "failed", "not_applicable", "not_run"] }, "evidence_hash": { "$ref": "#/$defs/Sha256" }, "summary": { "$ref": "#/$defs/SafeText" } } } },
        "tests_run": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["command_id", "exit_code", "output_hash", "output_summary", "timed_out", "output_overflowed", "worktree_mutated"], "properties": { "command_id": { "enum": ["format_check", "lint", "typecheck", "unit_tests", "build", "project_acceptance"] }, "exit_code": { "type": "integer" }, "output_hash": { "$ref": "#/$defs/Sha256" }, "output_summary": { "$ref": "#/$defs/SafeText" }, "timed_out": { "type": "boolean" }, "output_overflowed": { "type": "boolean" }, "worktree_mutated": { "type": "boolean" } } } },
        "scope_violations": { "type": "array", "items": { "$ref": "#/$defs/SafeText" } }, "privacy_violations": { "type": "array", "items": { "$ref": "#/$defs/SafeText" } },
        "secret_scan_summary": { "type": "object", "additionalProperties": false, "required": ["outcome", "findings", "baseline_findings", "new_findings"], "properties": { "outcome": { "enum": ["passed", "failed", "not_run"] }, "findings": { "type": "integer", "minimum": 0 }, "baseline_findings": { "type": "integer", "minimum": 0 }, "new_findings": { "type": "integer", "minimum": 0 } } },
        "usage_metrics": { "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "reasoning_tokens", "cached_input_tokens", "cache_write_tokens", "cache_hit_tokens", "cache_miss_tokens"], "properties": { "input_tokens": { "type": ["integer", "null"], "minimum": 0 }, "output_tokens": { "type": ["integer", "null"], "minimum": 0 }, "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 }, "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 }, "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 }, "cache_hit_tokens": { "type": ["integer", "null"], "minimum": 0 }, "cache_miss_tokens": { "type": ["integer", "null"], "minimum": 0 } } },
        "cost_metrics": { "type": "object", "additionalProperties": false, "required": ["provider_reported_usd", "estimated_list_usd", "invoice_usd", "chatgpt_quota"], "properties": { "provider_reported_usd": { "type": ["number", "null"], "minimum": 0 }, "estimated_list_usd": { "type": ["number", "null"], "minimum": 0 }, "invoice_usd": { "type": ["number", "null"], "minimum": 0 }, "chatgpt_quota": { "type": ["number", "null"], "minimum": 0 } } },
